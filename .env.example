# Copy to .env and fill in. NEVER commit the real .env file.

# development | production
APP_ENV=development

# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. Defaults to SQLite in ./instance/brandbridge.db
# DATABASE_URL=sqlite:///brandbridge.db
# DATABASE_URL=mysql+pymysql://user:password@host:3306/brandbridge   (pip install pymysql)
# DATABASE_URL=postgresql://user:password@host:5432/brandbridge

# Optional folder for private uploads (default ./uploads)
# UPLOAD_FOLDER=/var/data/uploads

# ---- Optional LLM assistance (the rule-based engine works without any of this) ----
# AI_PROVIDER=anthropic        # anthropic | openai | none  ("openai" works with any OpenAI-compatible API)
# AI_API_KEY=
# AI_MODEL=                    # e.g. a current Claude or GPT model id; sensible default if empty
# AI_BASE_URL=                 # only for self-hosted / compatible endpoints
# AI_TIMEOUT=25
